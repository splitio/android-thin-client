#!/usr/bin/env bash
set -euo pipefail

THRESHOLD="${COVERAGE_THRESHOLD:-80}"
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "Running unit-test coverage gate (line coverage >= ${THRESHOLD}%)..."
./gradlew -q jacocoAggregateUnitTestReport

XML_REPORT="build/reports/jacoco/jacocoAggregateUnitTestReport/jacocoAggregateUnitTestReport.xml"
if [[ ! -f "$XML_REPORT" ]]; then
  echo "ERROR: Coverage report not found at: $XML_REPORT"
  exit 1
fi

STAGED_SOURCES_FILE="$(mktemp)"
trap 'rm -f "$STAGED_SOURCES_FILE"' EXIT

git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(kt|java)$' \
  | grep -Ev '^(android-client/)' \
  | grep -Ev '(^|/)(src/(test|androidTest|testFixtures)/)' \
  | grep -Ev '(^|/)[^/]+Test(s)?\.(kt|java)$' \
  > "$STAGED_SOURCES_FILE" || true

python3 - "$XML_REPORT" "$THRESHOLD" "$STAGED_SOURCES_FILE" <<'PY'
import sys
import xml.etree.ElementTree as ET
import re

xml_path = sys.argv[1]
threshold = float(sys.argv[2])
staged_sources_path = sys.argv[3]

root = ET.parse(xml_path).getroot()

with open(staged_sources_path, "r", encoding="utf-8") as f:
    staged_sources = [line.strip() for line in f if line.strip()]

if not staged_sources:
    print("No staged non-test Kotlin/Java files detected; skipping coverage gate.")
    sys.exit(0)

# Build per-sourcefile LINE coverage map: "pkg/ClassName.kt" -> float percent
file_coverage: dict[str, float] = {}
for pkg in root.findall("package"):
    pkg_name = pkg.attrib.get("name", "")
    for sf in pkg.findall("sourcefile"):
        sf_name = sf.attrib.get("name", "")
        if not sf_name:
            continue
        key = f"{pkg_name}/{sf_name}" if pkg_name else sf_name
        for counter in sf.findall("counter"):
            if counter.attrib.get("type") == "LINE":
                missed = int(counter.attrib.get("missed", "0"))
                covered = int(counter.attrib.get("covered", "0"))
                total = missed + covered
                file_coverage[key] = (covered / total * 100.0) if total else 0.0
                break

def staged_path_to_jacoco_key(path: str) -> str | None:
    path = path.lstrip("./")
    m = re.search(r"/src/main/(?:java|kotlin)/(.+)$", path)
    return m.group(1) if m else None

failing: list[tuple[str, float | None]] = []
for path in staged_sources:
    if path.startswith("android-client/"):
        # android-client is a git submodule; coverage is not enforced here.
        continue
    key = staged_path_to_jacoco_key(path)
    if key is None:
        # Not under src/main/java|kotlin; nothing to enforce.
        continue
    if key not in file_coverage:
        # Absent from report means JaCoCo found no executable lines (e.g. pure
        # interfaces, annotation classes).  Nothing to cover → skip.
        continue
    else:
        pct = file_coverage[key]
        if pct < threshold:
            failing.append((path, pct))

if failing:
    print(f"Coverage gate failed (threshold: {threshold:.0f}%). Staged files below threshold:")
    for path, pct in failing:
        if pct is None:
            print(f"    n/a  {path}  (not found in coverage report)")
        else:
            print(f"  {pct:5.1f}%  {path}")
    print("Commit blocked.")
    sys.exit(1)

print(f"Coverage gate passed. All staged source files meet the {threshold:.0f}% line coverage threshold.")
PY
